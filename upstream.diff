+    &&& bv[j] <= b_vec_bound(t)
+    &&& (av[j] as int) % base() == lane_sum(s, j, g) % base()
+    &&& (bv[j] as int) % base() == lane_wsum(s, j, g) % base()
+}
+
+pub open spec fn lanes_partial(av: Seq<u32>, bv: Seq<u32>, s: Seq<u8>, g: int, t: int) -> bool {
+    &&& av.len() == 4
+    &&& bv.len() == 4
+    &&& 0 <= t <= 5552
+    &&& 0 <= g
+    &&& 4 * g <= s.len()
