+/// The overflow budget of one `CHUNK_SIZE` chunk: 5552 groups fit in `u32`.
+pub proof fn lemma_b_vec_bound(t: int)
+    requires
+        0 <= t < 5552,
+    ensures
+        b_vec_bound(t) + (base() - 1) + 255 * (t + 1) == b_vec_bound(t + 1),
+        b_vec_bound(t + 1) <= u32::MAX,
